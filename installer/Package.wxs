<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="Diffuse for Windows"
           Manufacturer="Diffuse"
           Version="$(var.Version)"
           UpgradeCode="8B8E5C2F-9F42-4B7A-9C35-3A2D4198B7E1"
           Scope="perUser">

    <SummaryInformation Description="Diffuse Live Wallpaper for Windows" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="DiffuseIcon.ico" SourceFile="$(var.AssetsDir)\diffuse.ico" />
    <Property Id="ARPPRODUCTICON" Value="DiffuseIcon.ico" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Diffuse for Windows" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.InstallerDir)\License.rtf" />

    <ui:WixUI Id="WixUI_InstallDir" />

    <CustomAction Id="LaunchApplication"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]DiffuseWindows.exe&quot;"
                  Execute="immediate"
                  Return="asyncNoWait" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchApplication"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and REMOVE &lt;&gt; &quot;ALL&quot;" />
    </UI>

    <InstallExecuteSequence>
      <Custom Action="LaunchApplication"
              After="InstallFinalize"
              Condition="REMOVE &lt;&gt; &quot;ALL&quot; and UILevel &lt; 4" />
    </InstallExecuteSequence>

    <util:CloseApplication Id="CloseDiffuseRunning"
                           Target="DiffuseWindows.exe"
                           CloseMessage="yes"
                           EndSessionMessage="yes"
                           TerminateProcess="1"
                           Timeout="5"
                           RebootPrompt="no" />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LocalProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Diffuse" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Diffuse" />
    </StandardDirectory>

    <Feature Id="MainFeature" Title="Diffuse for Windows" Level="1">
      <Files Directory="INSTALLFOLDER" Include="$(var.PublishDir)\**" />
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="AutoStartRegistry" />
    </Feature>

    <Component Id="AutoStartRegistry" Directory="INSTALLFOLDER" Guid="*">
      <RegistryValue Root="HKCU"
                     Key="Software\Microsoft\Windows\CurrentVersion\Run"
                     Name="DiffuseWindows"
                     Type="string"
                     Value="&quot;[INSTALLFOLDER]DiffuseWindows.exe&quot;"
                     KeyPath="yes" />
    </Component>

    <Component Id="StartMenuShortcuts" Directory="ApplicationProgramsFolder" Guid="*">
      <Shortcut Id="AppShortcut"
                Name="Diffuse"
                Description="Launch Diffuse Live Wallpaper in System Tray"
                Target="[INSTALLFOLDER]DiffuseWindows.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DiffuseIcon.ico" />
      <Shortcut Id="SettingsShortcut"
                Name="Diffuse Settings"
                Description="Launch Diffuse and Open Controls"
                Target="[INSTALLFOLDER]DiffuseWindows.exe"
                Arguments="--show-ui"
                WorkingDirectory="INSTALLFOLDER"
                Icon="DiffuseIcon.ico" />
      <RemoveFolder Id="RemoveProgramsDir" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\DiffuseWindows"
                     Name="InstallDir"
                     Type="string"
                     Value="[INSTALLFOLDER]"
                     KeyPath="yes" />
    </Component>
  </Package>
</Wix>
