<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiffuseWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Diffuse">

    <Grid x:Name="RootGrid" Background="Transparent" KeyDown="OnRootKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Compact Flyout Header -->
        <Grid Grid.Row="0" Padding="16,12,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#609BFF" Offset="0" />
                            <GradientStop Color="#E15FA5" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="Diffuse" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="DesktopStatusText"
                        Text="Progman"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                <ToggleButton
                    x:Name="PinButton"
                    ToolTipService.ToolTip="Keep flyout pinned"
                    Padding="7,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPinClick">
                    <FontIcon Glyph="&#xE718;" FontSize="13" />
                </ToggleButton>
                <Button
                    x:Name="ReattachButton"
                    ToolTipService.ToolTip="Re-attach behind desktop icons"
                    Padding="7,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnReattachClick">
                    <FontIcon Glyph="&#xE72C;" FontSize="13" />
                </Button>
                <Button
                    x:Name="PauseButton"
                    ToolTipService.ToolTip="Pause / Resume wallpaper"
                    Padding="7,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnPauseClick">
                    <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="13" />
                </Button>
                <Button
                    x:Name="QuitButton"
                    ToolTipService.ToolTip="Quit Diffuse"
                    Padding="7,6"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnQuitClick">
                    <FontIcon Glyph="&#xE7E8;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Scrollable Settings Cards -->
        <ScrollViewer
            Grid.Row="1"
            Padding="14,2,14,14"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10">

                <!-- Now Playing Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border CornerRadius="6" Width="56" Height="56" Background="{ThemeResource SubtleFillColorTertiaryBrush}">
                            <Image x:Name="AlbumArtImage" Stretch="UniformToFill" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock
                                x:Name="TrackTitleText"
                                Text="No Music Playing"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                x:Name="TrackArtistText"
                                Text="Using fallback palette"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <TextBlock
                                x:Name="TrackSourceText"
                                Text="SMTC · Waiting for media"
                                FontSize="11"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Shader & Motion Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Visuals &amp; Motion" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Post-processing" VerticalAlignment="Center" />
                            <ComboBox x:Name="EffectCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Blur" Tag="blur" />
                                <ComboBoxItem Content="Fluted Glass" Tag="flutedGlass" />
                                <ComboBoxItem Content="None" Tag="none" />
                            </ComboBox>
                        </Grid>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Fluid scale" FontSize="12.5" />
                                <TextBlock x:Name="ScaleValueText" Text="0.80" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="ScaleSlider" Minimum="0.10" Maximum="2.00" StepFrequency="0.02" SnapsTo="StepValues" />
                        </StackPanel>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock Text="Idle speed" FontSize="12.5" />
                                    <TextBlock x:Name="SpeedMinValueText" Text="0.05" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="SpeedMinSlider" Minimum="0.00" Maximum="1.50" StepFrequency="0.01" SnapsTo="StepValues" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Grid>
                                    <TextBlock Text="Playing speed" FontSize="12.5" />
                                    <TextBlock x:Name="SpeedMaxValueText" Text="0.50" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="SpeedMaxSlider" Minimum="0.05" Maximum="2.50" StepFrequency="0.01" SnapsTo="StepValues" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <Grid>
                                    <TextBlock Text="Brightness" FontSize="12.5" />
                                    <TextBlock x:Name="BrightnessValueText" Text="0.00" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="BrightnessSlider" Minimum="-1.00" Maximum="1.00" StepFrequency="0.05" SnapsTo="StepValues" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <Grid>
                                    <TextBlock Text="Saturation" FontSize="12.5" />
                                    <TextBlock x:Name="SaturationValueText" Text="1.00x" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </Grid>
                                <Slider x:Name="SaturationSlider" Minimum="0.00" Maximum="2.00" StepFrequency="0.05" SnapsTo="StepValues" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="2">
                            <Grid>
                                <TextBlock Text="Opacity" FontSize="12.5" />
                                <TextBlock x:Name="OpacityValueText" Text="100%" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="OpacitySlider" Minimum="25" Maximum="255" StepFrequency="5" SnapsTo="StepValues" />
                        </StackPanel>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="HDR output" />
                                <TextBlock Text="16-bit scRGB on HDR displays" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ComboBox x:Name="HdrModeCombo" Grid.Column="1" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Auto (Display HDR)" Tag="auto" />
                                <ComboBoxItem Content="Force On (scRGB)" Tag="on" />
                                <ComboBoxItem Content="Off (SDR)" Tag="off" />
                            </ComboBox>
                        </Grid>

                        <StackPanel x:Name="HdrIntensityPanel" Spacing="2">
                            <Grid>
                                <TextBlock Text="HDR peak boost" FontSize="12.5" />
                                <TextBlock x:Name="HdrIntensityValueText" Text="1.60x" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="HdrIntensitySlider" Minimum="0.50" Maximum="3.50" StepFrequency="0.05" SnapsTo="StepValues" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Audio & Palette Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Audio &amp; Palette" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Live Beats" />
                                <TextBlock Text="React to system audio FFT" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="LiveBeatsToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>

                        <StackPanel x:Name="BeatStrengthPanel" Spacing="2">
                            <Grid>
                                <TextBlock Text="Beat strength" FontSize="12.5" />
                                <TextBlock x:Name="BeatStrengthValueText" Text="0.50" FontSize="12" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                            <Slider x:Name="BeatStrengthSlider" Minimum="0.00" Maximum="2.00" StepFrequency="0.05" SnapsTo="StepValues" />
                        </StackPanel>

                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="PaletteCombo" HorizontalAlignment="Stretch" />
                            <Button x:Name="BrowsePaletteButton" Grid.Column="1" Content="Custom..." Click="OnBrowsePaletteClick" />
                            <Button x:Name="ResetPaletteButton" Grid.Column="2" ToolTipService.ToolTip="Reset custom image" Click="OnResetPaletteClick">
                                <FontIcon Glyph="&#xE777;" FontSize="13" />
                            </Button>
                        </Grid>

                        <Grid>
                            <TextBlock Text="Preserve art after pause" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="PreservePauseToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Performance & Desktop Card -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Performance &amp; Desktop" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FPS limit" />
                                <TextBlock Text="10 – 240 FPS" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <NumberBox
                                x:Name="FpsNumberBox"
                                Grid.Column="1"
                                Minimum="10"
                                Maximum="240"
                                SmallChange="5"
                                LargeChange="30"
                                SpinButtonPlacementMode="Inline" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="VSync (sync to display refresh)" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="VSyncToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Performance mode (LUT)" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="PerformanceToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Pause on fullscreen app" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="PauseFullscreenToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Span all monitors" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="SpanMonitorsToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>

                        <Grid>
                            <TextBlock Text="Attach behind desktop icons" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="AttachDesktopToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>

                        <Grid>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start with Windows" />
                                <TextBlock Text="Launch in system tray at sign-in" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StartWithWindowsToggle" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
