<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DiffuseWindows.InstallerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Diffuse Setup">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native WinUI 3 Extended Title Bar -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Padding="18,0,12,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10">
                    <Ellipse.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#609BFF" Offset="0" />
                            <GradientStop Color="#E15FA5" Offset="1" />
                        </LinearGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock x:Name="TitleBarLabel" Text="Diffuse Setup" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                    CornerRadius="4"
                    Padding="6,2"
                    VerticalAlignment="Center">
                    <TextBlock
                        x:Name="VersionPillText"
                        Text="dev"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </Grid>

        <!-- Setup Body -->
        <Grid Grid.Row="1" Padding="26,8,26,24">

            <!-- Install / Update Options -->
            <Grid x:Name="InstallOptionsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,2,0,18">
                    <Border Width="48" Height="48" CornerRadius="12">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5F9BFF" Offset="0" />
                                <GradientStop Color="#E15FA5" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon Glyph="&#xE771;" Foreground="White" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="InstallHeaderText" Text="Install Diffuse for Windows" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock Text="Fluid audio-reactive live wallpaper in your system tray." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1" Spacing="12" VerticalAlignment="Top">
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Install location" Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InstallPathBox" Grid.Column="0" />
                                <Button x:Name="BrowseButton" Grid.Column="1" Content="Browse..." Click="OnBrowseClick" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,12">
                        <StackPanel Spacing="10">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" />
                                    <TextBlock Text="Launch automatically in system tray at sign-in" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="StartupToggle" IsOn="True" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                            </Grid>

                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Launch Diffuse after install" />
                                    <TextBlock Text="Start wallpaper and open tray controls right away" FontSize="11.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="LaunchAfterToggle" IsOn="True" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                            </Grid>

                            <Grid>
                                <TextBlock Text="Create Desktop shortcut" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="DesktopShortcutToggle" IsOn="False" HorizontalAlignment="Right" MinWidth="0" OnContent="" OffContent="" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,14,0,0">
                    <TextBlock Text="Per-user install · No administrator privileges required" FontSize="11.5" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="OnCloseClick" />
                        <Button x:Name="InstallActionButton" Content="Install" Style="{ThemeResource AccentButtonStyle}" MinWidth="96" Click="OnInstallClick" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Uninstall Confirmation -->
            <Grid x:Name="UninstallOptionsPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="14" Margin="0,2,0,18">
                    <Border Width="48" Height="48" CornerRadius="12" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <FontIcon Glyph="&#xE74D;" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Uninstall Diffuse for Windows" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="UninstallPathText" Text="" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Row="1"
                    VerticalAlignment="Top"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,12">
                    <StackPanel Spacing="10">
                        <TextBlock Text="This will stop Diffuse, remove Start Menu and Desktop shortcuts, unregister Windows startup, and delete installed files." TextWrapping="Wrap" />
                        <CheckBox x:Name="RemoveDataCheckBox" Content="Also remove saved preferences and logs (%AppData%\DiffuseWindows)" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="OnCloseClick" />
                    <Button Content="Uninstall" Style="{ThemeResource AccentButtonStyle}" MinWidth="96" Click="OnUninstallClick" />
                </StackPanel>
            </Grid>

            <!-- Progress View -->
            <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" VerticalAlignment="Center" Spacing="14">
                <TextBlock x:Name="ProgressHeadingText" Text="Installing Diffuse..." Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                <ProgressBar x:Name="SetupProgressBar" Minimum="0" Maximum="100" Value="0" Height="6" />
                <TextBlock x:Name="ProgressStatusText" Text="Preparing..." FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Complete / Error View -->
            <Grid x:Name="CompletePanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center" Spacing="12">
                    <Border
                        x:Name="CompleteIconBadge"
                        Width="52"
                        Height="52"
                        CornerRadius="26"
                        HorizontalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5F9BFF" Offset="0" />
                                <GradientStop Color="#E15FA5" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <FontIcon x:Name="CompleteIcon" Glyph="&#xE73E;" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="CompleteTitleText" Text="Diffuse is installed" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="CompleteSubtitleText" Text="" FontSize="12.5" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <InfoBar x:Name="ErrorBanner" Severity="Error" IsOpen="False" IsClosable="False" Title="Setup failed" />
                </StackPanel>

                <Button
                    Grid.Row="1"
                    Content="Finish"
                    Style="{ThemeResource AccentButtonStyle}"
                    MinWidth="110"
                    HorizontalAlignment="Right"
                    Click="OnCloseClick" />
            </Grid>
        </Grid>
    </Grid>
</Window>
